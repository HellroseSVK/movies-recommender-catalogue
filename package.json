{
  "name": "movies-recommender-catalogue",
  "version": "1.0.0",
  "description": "Movie Recommender Catalogue Scripts",
  "scripts": {
    "install:film-person": "cd film-person-service && npm install",
    "install:movie": "cd movie-service && npm install",
    "install:feedback": "cd feedback-service && npm install",
    "postinstall": "run-p install:*",
    "preseed": "npm install",
    "seed": "npm run seed:film-person && npm run seed:movie && npm run seed:feedback",
    "seed:film-person": "cd film-person-service && npm run seed",
    "seed:movie": "cd movie-service && npm run seed",
    "seed:feedback": "cd feedback-service && npm run seed"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5"
  }
}
